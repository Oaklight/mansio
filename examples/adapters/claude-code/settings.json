{
  "mcpServers": {
    "mansio": {
      "command": "mansio-mcp",
      "args": [],
      "env": {
        "MANSIO_URL": "http://localhost:8742",
        "MANSIO_USER_ID": "claude-code-mansio-1"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "mansio-agent poll --format claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
