{
  "mcpServers": {
    "mansio": {
      "command": "mansio-mcp",
      "args": []
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "mansio-agent",
            "args": ["poll", "--format", "claude"],
            "timeout": 15,
            "statusMessage": "Checking mansio messages"
          }
        ]
      }
    ]
  }
}
