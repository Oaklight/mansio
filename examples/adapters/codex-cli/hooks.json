{
  "description": "Mansio message polling for Codex sessions",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "mansio-agent poll --format codex",
            "timeout": 15,
            "statusMessage": "Checking mansio messages"
          }
        ]
      }
    ]
  }
}
